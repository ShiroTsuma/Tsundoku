{
  "name": "tsundoku-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:run": "vitest run",
    "test:layout": "node ./scripts/run-playwright-layout.mjs",
    "test:layout:desktop": "node ./scripts/run-playwright-layout.mjs --project chromium-desktop",
    "test:layout:mobile": "node ./scripts/run-playwright-layout.mjs --project chromium-mobile",
    "test:layout:tablet": "node ./scripts/run-playwright-layout.mjs --project chromium-xiaomi-pad-6-portrait --project chromium-xiaomi-pad-6-landscape",
    "test:layout:tablet:update": "node ./scripts/run-playwright-layout.mjs --project chromium-xiaomi-pad-6-portrait --project chromium-xiaomi-pad-6-landscape --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "test:all": "npm run check && npm run test:layout"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.2.6",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hookform/resolvers": "5.4.0",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-router-dom": "7.18.1",
    "react-virtuoso": "4.18.10",
    "recharts": "3.9.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "6.3.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
