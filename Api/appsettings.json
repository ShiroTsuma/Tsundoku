{
    "Jwt": {
        "Key": "IN_SECRETS",
        "Issuer": "IN_SECRETS",
        "Audience": "IN_SECRETS",
        "AccessTokenMinutes": 10
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:5173",
            "http://localhost:3000",
            "http://localhost:4200"
        ]
    },
    "Admin": {
        "Emails": []
    },
    "RateLimiting": {
        "LoginIp": {
            "PermitLimit": 20,
            "WindowSeconds": 60
        },
        "LoginAccount": {
            "PermitLimit": 5,
            "WindowSeconds": 300
        },
        "Expensive": {
            "PermitLimit": 20,
            "WindowSeconds": 60
        }
    },
    "Authentication": {
        "MinimumFailureResponseMilliseconds": 250
    },
    "Database": {
        "AutoMigrate": false
    },
    "BookCovers": {
        "StorageRoot": "storage/covers",
        "MaxBytes": 10485760,
        "MaxWidth": 12000,
        "MaxHeight": 12000,
        "MaxPixels": 40000000,
        "UserAgent": "Tsundoku/1.0",
        "S3": {
            "Endpoint": "http://dockers.lan:3900",
            "Region": "garage",
            "AccessKey": "IN_ENV",
            "SecretKey": "IN_ENV",
            "Bucket": "tsundoku"
        }
    },
    "BookFiles": {
        "StorageRoot": "storage/epubs",
        "StagingRoot": "storage/epub-staging",
        "MaxFileBytes": 104857600,
        "MaxUploadBytes": 314572800,
        "MaxFilesPerImport": 100,
        "MaxExtractedBytes": 536870912,
        "MaxExpandedEpubBytes": 1073741824,
        "MaxArchiveEntries": 5000,
        "MaxOwnerStorageBytes": 10737418240,
        "MaxLibraryArchiveBytes": 12884901888,
        "MaxLibraryArchiveEntries": 50000,
        "MaxStagingBytes": 25769803776,
        "MaxConcurrentOperations": 2,
        "MaxActiveJobsPerOwner": 5,
        "ProcessingTimeout": "00:30:00",
        "JobLifetime": "02:00:00",
        "Retention": "30.00:00:00",
        "TicketLifetime": "00:01:00"
    },
    "BookImports": {
        "Security": {
            "MaxFullBackupRequestBytes": 314572800,
            "AdminMaxFullBackupRequestBytes": 629145600,
            "MaxArchiveEntries": 5000,
            "MaxCsvRows": 50000,
            "MaxManifestBooks": 50000,
            "MaxCsvBytes": 10485760,
            "MaxManifestBytes": 2097152,
            "MaxCoverBytes": 10485760,
            "MaxUncompressedArchiveBytes": 268435456,
            "AdminMaxUncompressedArchiveBytes": 536870912,
            "MaxCompressionRatio": 100,
            "SuspiciousCompressionRatio": 500,
            "SuspiciousCompressionMinimumBytes": 8388608,
            "SuspiciousAccountBlockDuration": "1.00:00:00",
            "MaxConcurrentFullImportOperations": 2,
            "MaxActiveSessionsGlobal": 50,
            "MaxActiveSessionsPerUser": 5,
            "MaxActiveFullSessionsGlobal": 10,
            "MaxActiveFullSessionsPerUser": 1,
            "MaxStagedBytesGlobal": 1073741824,
            "SessionIdleTimeout": "00:30:00",
            "SessionAbsoluteLifetime": "02:00:00",
            "CleanupInterval": "00:05:00",
            "DraftProcessingTimeout": "00:02:00",
            "FinalizeProcessingTimeout": "00:05:00"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "Properties": {
            "Application": "Tsundoku"
        }
    },
    "ConnectionStrings": {
        "DB": "Host=IN_SECRETS;Port=IN_SECRETS;Database=IN_SECRETS;Username=IN_SECRETS;Password=IN_SECRETS",
        "Redis": "IN_SECRETS"
    }
}
