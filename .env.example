# Defaults for new installations. Keep the existing .env when upgrading an instance.
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=tsundoku;Username=postgres;Password=postgres
REDIS_CONNECTION_STRING=localhost:6379
JWT_KEY=replace-with-a-long-local-development-secret-key
JWT_ISSUER=Tsundoku
JWT_AUDIENCE=Tsundoku
JWT_ACCESS_TOKEN_MINUTES=10
ADMIN_EMAIL=admin@example.com
RATE_LIMITING_LOGIN_IP_PERMIT_LIMIT=20
RATE_LIMITING_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMITING_LOGIN_ACCOUNT_PERMIT_LIMIT=5
RATE_LIMITING_LOGIN_ACCOUNT_WINDOW_SECONDS=300
RATE_LIMITING_EXPENSIVE_PERMIT_LIMIT=40
RATE_LIMITING_EXPENSIVE_WINDOW_SECONDS=60
RATE_LIMITING_FULL_BACKUP_WINDOW_MINUTES=20
AUTH_MINIMUM_FAILURE_RESPONSE_MILLISECONDS=250
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5232
WEB_PORT=8080
WEB_HTTP_PORT=8081
WEB_PUBLIC_ORIGIN=https://localhost:8080
PUBLIC_DOMAIN=localhost
PUBLIC_HTTPS_AUTHORITY=localhost:8080
ACME_ENABLED=false
ACME_EMAIL=
VITE_API_BASE_URL=/api/v1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
BOOK_COVERS__S3__ENDPOINT=http://dockers.lan:3900
BOOK_COVERS__S3__REGION=garage
BOOK_COVERS__S3__ACCESS_KEY=replace-with-s3-access-key
BOOK_COVERS__S3__SECRET_KEY=replace-with-s3-secret-key
BOOK_COVERS__S3__BUCKET=tsundoku
# EPUB storage; independent of CSV + covers backups
BOOK_FILES_OWNER_STORAGE_BYTES=10737418240
BOOK_FILES_LIBRARY_ARCHIVE_BYTES=12884901888
BOOK_FILES_STAGING_BYTES=25769803776
BOOK_FILES_ARCHIVE_UPLOAD_LIMIT=12289m
